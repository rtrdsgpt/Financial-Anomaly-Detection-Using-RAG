# Copy to .env and fill in. Never commit the real .env (already gitignored).

# Accepts a comma-separated list ("gsk_abc,gsk_def") for round-robin
# rotation when one key hits a rate limit -- see
# src/processors/groq_key_rotation.py. A single key works exactly as before.
GROQ_API_KEY=
FINNHUB_API_KEY=
OPENAI_API_KEY=

# Optional overrides -- see src/config/settings.py for the full list and defaults
# DEFAULT_TICKER=TSLA
# DEFAULT_BENCHMARK=SPY
# VECTOR_STORE_BACKEND=chroma
# USE_RERANKER=true
# USE_GROUNDED_CITATIONS=true
